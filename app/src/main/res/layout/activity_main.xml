<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/bg_main"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title offset generously with distinct stylized HotBoi Red branding -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:text="HotBoi"
            android:textColor="@color/hotboi_brand"
            android:textSize="21sp"
            android:letterSpacing="0.02"
            android:textStyle="bold" />

        <!-- Mode Status Pill -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="Offline"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Fahrenheit / Celsius Toggle Pill -->
        <TextView
            android:id="@+id/btnUnitToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="34dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="0dp"
            android:text="°F"
            android:textColor="@color/primary_cyan"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Error / Warning Button Pill -->
        <FrameLayout
            android:id="@+id/btnErrorLog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="View Errors">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@android:drawable/stat_notify_error"
                app:tint="#EF4444" />
        </FrameLayout>

        <!-- Refresh Button Styled as a Matching Pill -->
        <FrameLayout
            android:id="@+id/btnRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/refresh">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_popup_sync"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Settings Button Styled as a Matching Pill -->
        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/settings">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_manage"
                app:tint="@color/text_primary" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_border"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Swipe Refresh & WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Center Inline Refresh Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/primary_cyan"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Modern App Splash / Loading Page -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_main"
        android:gravity="center"
        android:orientation="vertical"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@drawable/badge_bg"
            android:padding="8dp"
            android:contentDescription="HotBoi Logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="HotBoi"
            android:textColor="@color/hotboi_brand"
            android:textSize="26sp"
            android:letterSpacing="0.02"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Universal SFP+ Optical Telemetry"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="28dp"
            android:indeterminateTint="@color/primary_cyan" />

        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Connecting to telemetry engine..."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
