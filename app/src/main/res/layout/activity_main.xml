<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@color/bg_main"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Title offset with distinct stylized HotBoi Red branding -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="HotBoi"
            android:textColor="@color/hotboi_brand"
            android:textSize="20sp"
            android:letterSpacing="0.02"
            android:textStyle="bold" />

        <!-- Mode Status Pill -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/badge_bg"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:paddingHorizontal="9dp"
            android:paddingVertical="0dp"
            android:text="Direct SSH"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Fahrenheit / Celsius Toggle Pill -->
        <TextView
            android:id="@+id/btnUnitToggle"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:paddingHorizontal="7dp"
            android:paddingVertical="0dp"
            android:text="°F"
            android:textColor="@color/primary_cyan"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Refresh Button Styled as a Matching Pill (Moved between temperature toggle and about) -->
        <FrameLayout
            android:id="@+id/btnRefresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/refresh">
            <ImageView
                android:id="@+id/ivRefreshIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Error / Warning Button Pill (Positioned right after operational tools) -->
        <FrameLayout
            android:id="@+id/btnErrorLog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="View Errors">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_warning"
                app:tint="#EF4444" />
        </FrameLayout>

        <!-- Vertical Separator Divider (|) between telemetry controls and meta controls -->
        <View
            android:id="@+id/topBarDivider"
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="6dp"
            android:background="@color/card_border" />

        <!-- About Button Styled as a Matching Pill -->
        <FrameLayout
            android:id="@+id/btnAbout"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="About HotBoi">
            <ImageView
                android:id="@+id/ivAboutIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_info"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Quick Theme Toggle Pill (Current state: Sun in Light, Moon in Dark) -->
        <FrameLayout
            android:id="@+id/btnThemeToggle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Toggle Light/Dark Theme">
            <ImageView
                android:id="@+id/ivThemeIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_dark_mode"
                app:tint="@color/text_primary" />
        </FrameLayout>

        <!-- Settings Button Styled as a Matching Pill -->
        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/badge_bg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/settings">
            <ImageView
                android:id="@+id/ivSettingsIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_border"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Swipe Refresh & WebView -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_main" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Center Inline Refresh Indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:indeterminateTint="@color/primary_cyan"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
