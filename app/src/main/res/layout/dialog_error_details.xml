<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="System Diagnostics &amp; Telemetry Log"
        android:textColor="#EF4444"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvActiveSystemMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Active Mode: Loading..."
        android:textColor="@color/accent_emerald"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvErrorSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="No active errors."
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- Dark styled terminal box with rounded corners for crisp, high-contrast readability -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="10dp"
        android:background="@color/console_bg"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvErrorDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="All systems operational. Telemetry engine active."
            android:textColor="#38BDF8"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClearError"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗑️ Clear"
            android:textColor="#EF4444"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCopyError"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="📋 Copy"
            android:textColor="@color/primary_cyan"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnRetryNow"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="🔄 Probe Again"
            android:textColor="@color/accent_emerald"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
