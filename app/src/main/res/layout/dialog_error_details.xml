<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/diagCardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/badge_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Modern Header Row: Warning Icon + Title + Top-Right Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_warning"
            app:tint="#EF4444"
            android:contentDescription="Warning" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="System Diagnostics &amp; Telemetry Log"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnCloseDiagTop"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:src="@drawable/ic_close"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_secondary"
            android:contentDescription="Close Diagnostics" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvActiveSystemMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="6dp"
        android:gravity="center_vertical"
        android:text="Active Mode: Loading..."
        android:textColor="@color/accent_emerald"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvErrorSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="No active errors."
        android:textColor="@color/text_primary"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- Modern Dark Console Box with rounded corners -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="10dp"
        android:background="@color/console_bg"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvErrorDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="All systems operational. Telemetry engine active."
            android:textColor="#60A5FA"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    <!-- Modern Action Bar conforming to modern Android Material 3 design -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnClearError"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Clear"
            android:textColor="#EF4444"
            android:textSize="11.5sp"
            app:icon="@drawable/ic_trash"
            app:iconTint="#EF4444"
            app:iconSize="14dp" />

        <Button
            android:id="@+id/btnCopyError"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="2dp"
            android:text="Copy"
            android:textColor="@color/primary_cyan"
            android:textSize="11.5sp"
            app:icon="@drawable/ic_copy"
            app:iconTint="@color/primary_cyan"
            app:iconSize="14dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnRetryNow"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:text="Probe"
            android:textColor="@color/accent_emerald"
            android:textSize="11.5sp"
            app:icon="@drawable/ic_refresh"
            app:iconTint="@color/accent_emerald"
            app:iconSize="14dp" />

        <Button
            android:id="@+id/btnCloseDiagBottom"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Close"
            android:textColor="@android:color/white"
            android:textSize="11.5sp" />
    </LinearLayout>

</LinearLayout>
